generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Mahasiswa {
  id Int @id @default(autoincrement())
  name String
  nim Int @unique
  status status @default(alpa)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum status {
  hadir
  izin
  alpa
}

