generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Mahasiswa {
  id Int @id @default(autoincrement())
  name String
  nim Int @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  Absens Absen[]

  @@index([deletedAt])
}

enum status {
  HADIR
  IZIN
  ALPA
}

model Kelas {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  Absens Absen[]

  @@index([deletedAt])
}

model Absen {
  id Int @id @default(autoincrement())
  mahasiswaId Int
  kelasId Int
  date DateTime @db.Date
  status status @default(ALPA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  mahasiswa Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  kelas Kelas @relation(fields: [kelasId], references: [id])

  @@unique([mahasiswaId, kelasId, date])
  @@index([deletedAt, date])
}